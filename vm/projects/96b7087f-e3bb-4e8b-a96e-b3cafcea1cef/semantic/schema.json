{
  "name": "Fusion5",
  "objects": {
    "Currency": {
      "kind": "entity",
      "description": "A currency, by its code."
    },
    "Subsidiary": {
      "kind": "entity",
      "description": "A Fusion5 legal entity.",
      "synonyms": [
        "entity",
        "company",
        "region",
        "country"
      ],
      "arrows": {
        "currency": "Currency",
        "parent": {
          "to": "Subsidiary",
          "partial": true
        }
      },
      "members": {
        "1": "F5 Parent",
        "2": "Fusion5 Pty Ltd",
        "3": "Fusion5 Ltd"
      },
      "names": {
        "AU": "2",
        "Australia": "2",
        "NZ": "3",
        "New Zealand": "3"
      }
    },
    "Pillar": {
      "kind": "entity",
      "description": "A practice pillar (NetSuite department), in a tree: BC, CEC, FO and Retail are under Microsoft.",
      "synonyms": [
        "practice",
        "department",
        "business unit"
      ],
      "arrows": {
        "parent": {
          "to": "Pillar",
          "partial": true
        }
      }
    },
    "Customer": {
      "kind": "entity",
      "description": "A client.",
      "synonyms": [
        "client"
      ]
    },
    "ProjectType": {
      "kind": "entity",
      "description": "A project's contract type: Implementation, Milestone Fixed Price, PartnerPlus, \u2026",
      "synonyms": [
        "contract type",
        "job type"
      ]
    },
    "ProjectStatus": {
      "kind": "entity",
      "description": "A project's status; In Progress is live work.",
      "synonyms": [
        "status"
      ]
    },
    "WorkCalendar": {
      "kind": "entity",
      "description": "A working pattern with its public holidays."
    },
    "ReportLine": {
      "kind": "entity",
      "description": "Where an account is reported: consulting revenue is the three services revenue accounts delivered through allocated hours (5005 Consulting, 5010 Consulting - Intercompany, 5102 PartnerPlus - CST PrePaid Hours).",
      "members": {
        "consulting revenue": "Consulting revenue"
      },
      "names": {
        "Consulting revenue": "consulting revenue",
        "revenue": "consulting revenue"
      }
    },
    "Account": {
      "kind": "entity",
      "description": "A general ledger account.",
      "arrows": {
        "report line": {
          "to": "ReportLine",
          "partial": true
        }
      }
    },
    "BudgetCategory": {
      "kind": "entity",
      "description": "A version of the budget.",
      "synonyms": [
        "budget version"
      ],
      "members": {
        "1": "Legacy",
        "2": "Forecast",
        "4": "Fusion5 Australia",
        "5": "Local $ currency",
        "6": "GBP Budget",
        "7": "Forecast 6+6",
        "8": "Reforecast 9+3",
        "9": "Forecast 3+9"
      },
      "names": {
        "Base Budget": "5",
        "base": "5"
      }
    },
    "Person": {
      "kind": "entity",
      "description": "An employee.",
      "synonyms": [
        "employee",
        "resource",
        "consultant",
        "staff"
      ],
      "arrows": {
        "subsidiary": "Subsidiary",
        "pillar": {
          "to": "Pillar",
          "partial": true
        },
        "manager": {
          "to": "Person",
          "partial": true
        },
        "calendar": {
          "to": "WorkCalendar",
          "partial": true
        }
      }
    },
    "Project": {
      "kind": "entity",
      "description": "A client project (NetSuite job).",
      "synonyms": [
        "job",
        "engagement"
      ],
      "arrows": {
        "subsidiary": "Subsidiary",
        "pillar": {
          "to": "Pillar",
          "partial": true
        },
        "customer": {
          "to": "Customer",
          "partial": true
        },
        "currency": "Currency",
        "type": {
          "to": "ProjectType",
          "partial": true
        },
        "status": {
          "to": "ProjectStatus",
          "partial": true
        },
        "manager": {
          "to": "Person",
          "partial": true
        },
        "senior supplier": {
          "to": "Person",
          "partial": true
        }
      },
      "attributes": {
        "rag": {
          "type": "text",
          "members": [
            "Red",
            "Amber",
            "Green"
          ],
          "synonyms": [
            "RAG",
            "RAG status",
            "health",
            "rating"
          ],
          "description": "the project's current Red/Amber/Green rating; not set on some projects"
        },
        "go-live": {
          "type": "date",
          "synonyms": [
            "go-live date",
            "next go-live",
            "going live"
          ],
          "description": "the next go-live date"
        },
        "gone live": {
          "type": "flag",
          "members": [
            "T",
            "F"
          ],
          "description": "whether the project has already gone live"
        },
        "start": {
          "type": "date",
          "synonyms": [
            "start date"
          ]
        },
        "end": {
          "type": "date",
          "synonyms": [
            "end date"
          ],
          "description": "the end date, or the calculated end date when none is set"
        },
        "created": {
          "type": "date",
          "synonyms": [
            "created date"
          ]
        },
        "at risk": {
          "type": "flag",
          "members": [
            "T",
            "F"
          ],
          "description": "rated Red or Amber, or with more budget consumed than its total budget"
        }
      }
    },
    "Commitment": {
      "kind": "entity",
      "description": "Whether an allocation is confirmed.",
      "members": {
        "Hard": "Hard",
        "Soft": "Soft"
      }
    },
    "Billable": {
      "kind": "entity",
      "description": "Whether time or an allocation is billable.",
      "members": {
        "T": "Billable",
        "F": "Not billable"
      }
    },
    "Approval": {
      "kind": "entity",
      "description": "Where a timesheet line is in approval.",
      "members": {
        "0": "Not recorded",
        "1": "Open",
        "2": "Pending Approval",
        "3": "Approved",
        "4": "Rejected"
      }
    },
    "Day": {
      "kind": "calendar",
      "level": "day",
      "arrows": {
        "month": "Month",
        "week": "Week"
      }
    },
    "Week": {
      "kind": "calendar",
      "level": "week"
    },
    "Month": {
      "kind": "calendar",
      "level": "month",
      "arrows": {
        "quarter": "Quarter"
      }
    },
    "Quarter": {
      "kind": "calendar",
      "level": "quarter",
      "arrows": {
        "year": "Year"
      }
    },
    "Year": {
      "kind": "calendar",
      "level": "year"
    },
    "AllocationDay": {
      "kind": "fact",
      "description": "Resource allocations spread over the working days of each person's calendar: the hours falling on one day.",
      "synonyms": [
        "allocation",
        "resource allocation",
        "booking",
        "forecast"
      ],
      "arrows": {
        "person": "Person",
        "project": "Project",
        "day": "Day",
        "commitment": "Commitment",
        "billable": "Billable"
      },
      "defaults": {
        "Subsidiary": [
          "project",
          "subsidiary"
        ],
        "Pillar": [
          "project",
          "pillar"
        ]
      },
      "measures": {
        "hours": {
          "unit": "h",
          "kind": "flow",
          "aggregate": "sum",
          "synonyms": [
            "allocated hours",
            "booked hours"
          ]
        },
        "revenue": {
          "unit": "money",
          "kind": "flow",
          "aggregate": "sum",
          "currency": [
            "project",
            "currency"
          ],
          "synonyms": [
            "projected revenue",
            "forecast revenue",
            "allocation revenue"
          ]
        },
        "unpriced hours": {
          "unit": "h",
          "kind": "flow",
          "aggregate": "sum",
          "synonyms": [
            "hours with no rate"
          ]
        },
        "people": {
          "unit": "people",
          "kind": "flow",
          "aggregate": "count distinct",
          "of": "person",
          "synonyms": [
            "headcount",
            "resources"
          ]
        }
      },
      "keptTo": [
        "valid project"
      ],
      "history": "current"
    },
    "TimeDay": {
      "kind": "fact",
      "description": "Time recorded against projects: a person's hours on a project on a day, with the revenue it delivered.",
      "synonyms": [
        "timesheet",
        "time",
        "actuals",
        "time entries"
      ],
      "arrows": {
        "person": "Person",
        "project": "Project",
        "day": "Day",
        "approval": "Approval",
        "billable": "Billable",
        "time type": "TimeType",
        "currency": "Currency"
      },
      "defaults": {
        "Subsidiary": [
          "project",
          "subsidiary"
        ],
        "Pillar": [
          "project",
          "pillar"
        ]
      },
      "measures": {
        "hours": {
          "unit": "h",
          "kind": "flow",
          "aggregate": "sum",
          "synonyms": [
            "actual hours",
            "worked hours",
            "timesheet hours",
            "hours logged"
          ]
        },
        "revenue": {
          "unit": "money",
          "kind": "flow",
          "aggregate": "sum",
          "currency": [
            "currency"
          ],
          "synonyms": [
            "actual revenue",
            "revenue delivered",
            "T&M revenue",
            "revenue forecast",
            "charged"
          ]
        },
        "people": {
          "unit": "people",
          "kind": "flow",
          "aggregate": "count distinct",
          "of": "person"
        }
      },
      "keptTo": [
        "valid project"
      ]
    },
    "BudgetLine": {
      "kind": "fact",
      "description": "A budgeted amount for a subsidiary, pillar and account in a month, in one budget category (the Base Budget is category 5).",
      "synonyms": [
        "budget"
      ],
      "arrows": {
        "subsidiary": "Subsidiary",
        "pillar": {
          "to": "Pillar",
          "kind": "belongs",
          "partial": true
        },
        "account": "Account",
        "category": {
          "to": "BudgetCategory",
          "kind": "version"
        },
        "month": "Month",
        "currency": "Currency"
      },
      "measures": {
        "budget": {
          "unit": "money",
          "kind": "flow",
          "aggregate": "sum",
          "currency": [
            "currency"
          ],
          "versions": "category",
          "synonyms": [
            "budget amount",
            "base budget"
          ]
        }
      }
    },
    "ExchangeRate": {
      "kind": "fact",
      "description": "Units of one currency per unit of another, by day.",
      "arrows": {
        "from": "Currency",
        "to": "Currency",
        "day": "Day"
      },
      "measures": {
        "rate": {
          "unit": "ratio",
          "kind": "value-per-unit",
          "aggregate": "max"
        }
      }
    },
    "TimeType": {
      "kind": "entity",
      "description": "How a time entry is classified.",
      "synonyms": [
        "time type"
      ],
      "members": {
        "A": "Actual",
        "P": "Planned",
        "B": "Allocated"
      }
    },
    "ProjectState": {
      "kind": "fact",
      "description": "Each project as it stands now: counted, with its total budget and what has been consumed.",
      "synonyms": [
        "project",
        "projects",
        "project budget"
      ],
      "arrows": {
        "project": "Project"
      },
      "keptTo": [
        "valid project"
      ],
      "history": "current",
      "defaults": {
        "Subsidiary": [
          "project",
          "subsidiary"
        ],
        "Pillar": [
          "project",
          "pillar"
        ]
      },
      "measures": {
        "projects": {
          "unit": "projects",
          "kind": "flow",
          "aggregate": "count distinct",
          "of": "project",
          "synonyms": [
            "project count",
            "number of projects"
          ]
        },
        "total budget": {
          "unit": "money",
          "kind": "flow",
          "aggregate": "sum",
          "currency": [
            "project",
            "currency"
          ],
          "synonyms": [
            "project budget",
            "budget"
          ]
        },
        "budget consumed": {
          "unit": "money",
          "kind": "flow",
          "aggregate": "sum",
          "currency": [
            "project",
            "currency"
          ],
          "synonyms": [
            "actual budget consumed",
            "consumed"
          ]
        },
        "remaining budget": {
          "unit": "money",
          "kind": "flow",
          "aggregate": "sum",
          "currency": [
            "project",
            "currency"
          ],
          "synonyms": [
            "budget remaining"
          ]
        }
      }
    }
  },
  "conditions": {
    "valid project": {
      "on": "Project",
      "description": "a real project, with a status and a type",
      "where": [
        {
          "to": "ProjectStatus",
          "via": [
            "status"
          ],
          "none": false
        },
        {
          "to": "ProjectType",
          "via": [
            "type"
          ],
          "none": false
        }
      ]
    },
    "PMO project": {
      "on": "Project",
      "description": "In Progress, in the consulting and milestone project types the PMO Summary counts",
      "synonyms": [
        "PMO population",
        "PMO summary projects"
      ],
      "where": [
        {
          "to": "ProjectStatus",
          "via": [
            "status"
          ],
          "in": [
            "2"
          ]
        },
        {
          "to": "ProjectType",
          "via": [
            "type"
          ],
          "in": [
            "1",
            "5",
            "7",
            "11",
            "14",
            "19",
            "20",
            "21",
            "24"
          ]
        }
      ]
    },
    "at-risk project": {
      "on": "Project",
      "description": "rated Red or Amber, or over its total budget",
      "synonyms": [
        "risky project",
        "projects at risk"
      ],
      "where": [
        {
          "attribute": "at risk",
          "in": [
            "T"
          ]
        }
      ]
    },
    "base revenue budget": {
      "on": "BudgetLine",
      "description": "the Base Budget (category 5) on the three services revenue accounts that projected allocation revenue is compared with",
      "synonyms": [
        "base budget",
        "budget target"
      ],
      "where": [
        {
          "to": "BudgetCategory",
          "via": [
            "category"
          ],
          "in": [
            "5"
          ]
        },
        {
          "to": "ReportLine",
          "via": [
            "account",
            "report line"
          ],
          "in": [
            "consulting revenue"
          ]
        }
      ]
    },
    "billable actual time": {
      "on": "TimeDay",
      "description": "billable time of the Actual type",
      "synonyms": [
        "billable hours",
        "actual billable hours"
      ],
      "where": [
        {
          "to": "Billable",
          "via": [
            "billable"
          ],
          "in": [
            "T"
          ]
        },
        {
          "to": "TimeType",
          "via": [
            "time type"
          ],
          "in": [
            "A"
          ]
        }
      ]
    }
  },
  "conversion": {
    "fact": "ExchangeRate",
    "from": "from",
    "to": "to",
    "day": "day",
    "rate": "rate",
    "at": "end"
  }
}
