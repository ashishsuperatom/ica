{
  "name": "fte",
  "kind": "concept",
  "description": "People employed, and their full-time equivalent, as at an instant.",
  "reads": { "sources": ["F5NETSUITE"], "programs": [] },
  "params": {},
  "returns": "relation",
  "shape": {
    "dimensions": {
      "employee":   { "column": "employee_id",   "label": "employee_name",   "history": "stable" },
      "pillar":     { "column": "pillar_id",     "label": "pillar_name",     "history": "current" },
      "subsidiary": { "column": "subsidiary_id", "label": "subsidiary_name", "history": "current" }
    },
    "measures": {
      "headcount": { "aggregate": "count distinct", "column": "employee_id", "unit": "people", "kind": "stock" },
      "fte":       { "aggregate": "sum", "column": "fte", "unit": "FTE", "kind": "stock" }
    }
  }
}
