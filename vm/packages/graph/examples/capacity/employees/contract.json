{
  "name": "employees",
  "kind": "concept",
  "description": "The people employed as at an instant, one row each, with who they report to, where they work and their title.",
  "reads": { "sources": ["F5NETSUITE"], "programs": [] },
  "params": {},
  "returns": "relation",
  "shape": {
    "grain": "employee",
    "dimensions": {
      "employee": { "column": "employee_id", "label": "employee_name", "history": "stable", "entity": "employee" },
      "manager":  { "column": "manager_id",  "label": "manager_name",  "history": "current", "entity": "employee" },
      "location": { "column": "location_id", "label": "location_name", "history": "current" },
      "title":    { "column": "title", "history": "current" }
    },
    "measures": {
      "headcount": { "aggregate": "count", "unit": "people", "kind": "stock" }
    }
  }
}
