{
  "name": "A consultancy — resource allocation and revenue",
  "objects": {
    "Project": { "kind": "entity", "description": "A client project.", "synonyms": ["job", "engagement"],
      "arrows": { "company": "Company", "practice": "Practice", "customer": "Customer", "currency": "Currency", "type": "ProjectType",
                  "manager": "Person", "sponsor": { "to": "Person", "partial": true } } },
    "Person": { "kind": "entity", "description": "An employee.", "synonyms": ["employee", "resource", "consultant"],
      "arrows": { "company": "Company", "practice": { "to": "Practice", "kind": "as-of" }, "manager": { "to": "Person", "partial": true } } },
    "Customer": { "kind": "entity", "synonyms": ["client"] },
    "Company": { "kind": "entity", "arrows": { "currency": "Currency" },
      "members": { "2": "Acme Consulting Pty Ltd", "3": "Acme Consulting Ltd" }, "names": { "AU": "2", "Northland": "2", "NZ": "3", "Southland": "3" } },
    "Practice": { "kind": "entity", "synonyms": ["practice", "department"],
      "members": { "15": "Data", "42": "Cloud", "37": "Security", "5": "Apps" }, "names": { "Data": "15", "Cloud": "42", "Security": "37", "Apps": "5" } },
    "Currency": { "kind": "entity", "members": { "AUD": "Australian dollar", "NZD": "Southland dollar" } },
    "ProjectType": { "kind": "entity", "members": { "14": "Fixed price", "1": "Time and materials", "3": "Prepaid support" } },
    "Account": { "kind": "entity", "members": { "5005": "Consulting", "5102": "Prepaid support hours", "5010": "Consulting (intercompany)" } },
    "BudgetCategory": { "kind": "entity", "members": { "5": "Original", "7": "Reforecast" }, "names": { "Opening Plan": "5" } },
    "Day": { "kind": "calendar", "level": "day", "arrows": { "month": "Month" } },
    "Month": { "kind": "calendar", "level": "month", "arrows": { "quarter": "Quarter" } },
    "Quarter": { "kind": "calendar", "level": "quarter", "arrows": { "year": "Year" } },
    "Year": { "kind": "calendar", "level": "year" },

    "BookingDay": { "kind": "fact", "description": "Resource allocation spread over working days: the hours on one day.",
      "synonyms": ["allocation", "resource allocation", "booking"],
      "arrows": { "person": "Person", "project": "Project", "day": "Day" },
      "attributes": { "commitment": { "members": ["Hard", "Soft"] } },
      "measures": {
        "hours": { "unit": "h", "kind": "flow", "aggregate": "sum", "synonyms": ["booked hours"] },
        "revenue": { "unit": "money", "kind": "flow", "aggregate": "sum", "currency": ["project", "currency"], "synonyms": ["projected revenue", "projected revenue"] },
        "unpriced hours": { "unit": "h", "kind": "flow", "aggregate": "sum" },
        "people": { "unit": "people", "kind": "flow", "aggregate": "count distinct", "of": "person", "synonyms": ["headcount"] }
      } },
    "TimesheetLine": { "kind": "fact", "description": "Hours recorded by one person on one day on one project.",
      "synonyms": ["timesheet", "actuals"],
      "arrows": { "person": "Person", "project": "Project", "day": "Day" },
      "attributes": { "approval": { "members": ["Open", "Approved"] } },
      "measures": {
        "hours": { "unit": "h", "kind": "flow", "aggregate": "sum", "synonyms": ["actual hours"] },
        "charged": { "unit": "money", "kind": "flow", "aggregate": "sum", "currency": ["project", "currency"], "synonyms": ["billed revenue"] }
      } },
    "PlanLine": { "kind": "fact", "description": "A budgeted amount for a company, practice and account in a month, in one budget category.",
      "synonyms": ["budget"],
      "arrows": { "company": "Company", "practice": "Practice", "account": "Account", "category": { "to": "BudgetCategory", "kind": "version" }, "month": "Month" },
      "measures": { "budget": { "unit": "money", "kind": "flow", "aggregate": "sum", "currency": ["company", "currency"], "versions": "category" } } },
    "RateCard": { "kind": "fact", "description": "The hourly rate a person is charged at on a project.",
      "arrows": { "project": "Project", "person": "Person" },
      "measures": { "rate": { "unit": "money/h", "kind": "value-per-unit", "aggregate": "max", "currency": ["project", "currency"] } } },
    "ExchangeRate": { "kind": "fact", "arrows": { "from": "Currency", "to": "Currency", "day": "Day" },
      "measures": { "rate": { "unit": "ratio", "kind": "value-per-unit", "aggregate": "max" } } }
  },
  "conversion": { "fact": "ExchangeRate", "from": "from", "to": "to", "day": "day", "rate": "rate", "at": "end" }
}
