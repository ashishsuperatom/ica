{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "superatom-reporting",
  "main": "src/worker.ts",
  "account_id": "91e1058d99235b9c34602fb0c28916d3",
  // The newest date the pinned runtime supports; read the runtime changes dated in between before moving it again.
  "compatibility_date": "2026-10-01",
  "workers_dev": true,

  // Fonts ship as bundled binary modules (ArrayBuffers), so there is no fetch on the render path. See src/fonts.ts for
  // when this should move to R2 instead.
  "rules": [
    { "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true }
  ],

  // Storage is R2 — NOT KV (eventually consistent, and a CDN fetches a report seconds after it is written, from another
  // region) and NOT a Durable Object (a report is immutable and read globally; a DO would pin every read to one
  // region). Shared bucket: everything this worker touches lives under the `reporting/` prefix.
  "r2_buckets": [
    { "binding": "REPORTS", "bucket_name": "frontend-packages" }
  ],

  // The mail relay is not part of the render path. Its ledger is coordination-only metadata (a hashed key, sending/sent,
  // timestamp, Cloudflare message id), one SQLite Durable Object per project. No email content is stored.
  "durable_objects": {
    "bindings": [
      { "name": "MAIL_DELIVERY", "class_name": "MailDelivery" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MailDelivery"] }
  ],

  // Cloudflare Email Sending. Keep the allowlist to the one sender this worker's mail path uses. The API also enforces
  // it, so a bad MAIL_FROM cannot quietly turn into a different sender.
  "send_email": [
    { "name": "EMAIL", "allowed_sender_addresses": ["reports@superatom.ai"] }
  ],

  "vars": {
    // SERVICE_TOKEN, SIGNING_KEY, MAIL_SIGNING_KEYS and MAIL_DEDUPE_KEY are secrets — `wrangler secret put`, never here.
    "PUBLIC_ORIGIN": "https://reports.superatom.site",
    "MAIL_FROM": "reports@superatom.ai",
    "MAIL_ALLOWED_DOMAINS": "dabur.com,superatom.ai"
  },

  // The hub worker holds the wildcard `*.superatom.site/*`. This route is MORE SPECIFIC, and Cloudflare picks the most
  // specific match, so reports.* lands here while every other subdomain keeps going to the hub.
  // mail.superatom.ai is HTTP only: no MX, SPF or DKIM records belong on that hostname (sending DNS is on cf-bounce).
  "routes": [
    { "pattern": "reports.superatom.site/*", "zone_name": "superatom.site" },
    { "pattern": "mail.superatom.ai/*", "zone_name": "superatom.ai" }
  ]
}
