{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.19/MicrosoftTeams.schema.json",
  "manifestVersion": "1.19",
  "version": "0.0.1",
  "id": "${{TEAMS_APP_ID}}",
  "developer": {
    "name": "Superatom",
    "websiteUrl": "https://superatom.ai",
    "privacyUrl": "https://superatom.ai/privacy",
    "termsOfUseUrl": "https://superatom.ai/terms"
  },
  "name": {
    "short": "Superatom",
    "full": "Superatom — decision intelligence"
  },
  "description": {
    "short": "Ask questions about your data, get computed answers.",
    "full": "Superatom turns a question into an answer by building and running a program over your data, then replies with the result — prose, key figures, and a table."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#15385C",
  "bots": [
    {
      "botId": "${{BOT_ID}}",
      "scopes": ["personal", "team", "groupChat"],
      "supportsFiles": false,
      "isNotificationOnly": false
    }
  ],
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": []
}
