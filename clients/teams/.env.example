# ── Superatom engine (the hub the bot connects to as a `runtime` peer) ──────────
# WebSocket base of the hub, e.g. wss://superatom.site (the /_ws/<projectId> path
# is appended by the client).
SA_HUB_WS=wss://superatom.site
# Which project this bot talks to (e.g. totalgroup's project id).
SA_PROJECT_ID=
# v1 credential: the per-PROJECT API key (sk-proj-…) — the DO accepts this for
# server-side "adapters" (the same key the code-engine uses; on the Fly machine
# it's the ICA_KEY env). This is all you need for the first end-to-end test.
SA_ENGINE_KEY=
# (Future) per-user platform JWT — see docs/identity-and-access.md. Unused in v1.
SA_ENGINE_TOKEN=

# ── Microsoft Teams / Azure Bot ────────────────────────────────────────────────
# From the Azure Bot resource (App Registration). Leave blank to run the bot
# locally with the Bot Framework Emulator (no auth).
MicrosoftAppId=
MicrosoftAppPassword=
# "MultiTenant" | "SingleTenant" | "UserAssignedMSI"
MicrosoftAppType=MultiTenant
# Only for SingleTenant:
MicrosoftAppTenantId=

# Local server port (must match the messaging endpoint you expose).
PORT=3978
