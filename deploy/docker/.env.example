# Superatom engine (Docker) — per-project connection + keys. Copy to .env and fill.
# Paths/ports live in docker-compose.yml (on the persistent /app/data volume) — you only fill these.

# The project this engine serves, and its credential (from the admin / control plane).
ICA_PROJECT=
ICA_KEY=

# The Cloudflare hub — BASE only. The engine appends /_ws/<project>?key=<key> itself.
ICA_HUB=wss://superatom.site

# Coding-agent auth: recommended to run `docker compose exec engine claude login` once instead.
# Or paste a subscription OAuth token here:
# CLAUDE_CODE_OAUTH_TOKEN=
