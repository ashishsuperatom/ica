# Superatom engine — per-project connection + keys (the same values a Fly machine is given).
# Copy to .env and fill in. Infra paths + ports are set by run.sh — you only fill these.

# The project this engine serves, and its credential (from the admin / control plane).
ICA_PROJECT=
ICA_KEY=

# The Cloudflare hub — BASE only. The engine appends /_ws/<project>?key=<key> itself.
ICA_HUB=wss://superatom.site

# Coding-agent auth: recommended to run `claude login` once on this box instead.
# If you'd rather not, paste a subscription OAuth token here:
# CLAUDE_CODE_OAUTH_TOKEN=

# --- optional overrides (defaults are fine) ---
# DATASOURCE_URL=http://localhost:4000
# ICA_OC_URL=http://127.0.0.1:4096
# ICA_REFLEX_MODEL=deepseek-v4-flash
