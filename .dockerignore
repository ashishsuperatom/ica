# Build-context hygiene for the Fly VM template image.
# Goal: ship ONLY the engine source; keep secrets, local state, and deps OUT.
# (Context root = repo root; Dockerfile COPYs vm/. The image runs its own pnpm install.)

# ── deps (regenerated by `pnpm install --frozen-lockfile` in the image) ──
**/node_modules

# ── build outputs ──
**/dist

# ── vcs / editor / dev process manager ──
.git
.gitignore
.wrangler
**/.DS_Store
ecosystem.config.cjs

# ── not part of the engine image ──
cloudflare
fast-router
server

# ── ROOT docs only. IMPORTANT: do NOT use **/*.md — the engine reads its agent
#    system prompts (agents/**/system/*.md, agents/**/SYSTEM.md) at runtime. ──
*.md

# ── local runtime state — never bake a project's data into the template image ──
**/.agent-workspace
**/.data
**/.ica-workspace

# ── SECRETS — env files + keys never enter the image.
#    Fly injects ICA_PROJECT/ICA_KEY/ICA_HUB via machine env; agent auth is manual via SSH. ──
**/.env
**/.env.*
**/*.pem
