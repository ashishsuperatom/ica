node_modules
.env
.wrangler
**/.wrangler

# secrets — never commit (datasource keys / private keys)
*.pem
*.env

# build output — compiled, regenerated
dist/
**/dist/

# local databases / editor junk
*.sqlite
*.sqlite-*
.DS_Store

# Generated runtime state — never source
*.db
*.db-shm
*.db-wal
vm/apps/workspace/

# engine runtime databases (created at boot; not source)
vm/apps/engine/.data/

# per-run program output (real data; regenerated by the kernel)
vm/projects/totalgroup/programs/**/program.json

# Linux-deploy build output (the packaged zip)
/dist/

# The fastembed model cache — a 127MB download, regenerated on first use. It was committed by accident and
# rejected by GitHub, which is how it was found. It is a cache, not source.
.fastembed/

# deploy targets (hosts/ports change; not shared)
.deploy-targets.env

# Python bytecode
__pycache__/
*.pyc
