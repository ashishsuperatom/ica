{
  // The user UI is a SEPARATE package built by vite, and `vite build` does not typecheck — a crash-on-render
  // shipped once because of exactly that. This config exists so `tsc --noEmit` can be run over it, and the
  // deploy script runs it before building. Browser only: DOM lib, no Workers types.
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "bundler", "jsx": "react-jsx",
    "strict": true, "noEmit": true, "skipLibCheck": true, "esModuleInterop": true, "resolveJsonModule": true,
    "types": ["vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
