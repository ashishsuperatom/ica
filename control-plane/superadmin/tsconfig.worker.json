{
  // The WORKER half: the edge runtime and its Durable Objects. Workers types, no DOM.
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022"],
    "module": "ESNext", "moduleResolution": "bundler",
    "strict": true, "noEmit": true, "skipLibCheck": true, "esModuleInterop": true, "resolveJsonModule": true,
    "types": ["./worker-configuration.d.ts"]
  },
  "include": ["src/**/*.ts", "worker-configuration.d.ts"],
  "exclude": ["src/__tests__/**", "src/**/*.tsx", "src/hub.ts", "src/termColors.ts"]
}
