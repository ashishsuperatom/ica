{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "superatom-code-engine",
  "main": "src/worker.ts",
  "account_id": "91e1058d99235b9c34602fb0c28916d3",
  // The newest date the pinned runtime supports. Moving it turns on the runtime changes dated in between — read them
  // (developers.cloudflare.com/workers/configuration/compatibility-flags) before moving it again.
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Cloud connectors (connectors/) run in Dynamic Workers, loaded by hash: their only way out is the ConnectorGateway
  // entrypoint (the connection's credentials added there); code mode's programs have no network, only ConnectorProxy.
  "worker_loaders": [{ "binding": "LOADER" }],
  // Workers Logs and Traces (Cloudflare's own observability): what the Worker and its Durable Objects log, and traces
  // of their calls — sampled, kept by Cloudflare for days. The audit history is separate (the AUDIT pipeline).
  "observability": {
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },

  "durable_objects": {
    "bindings": [
      { "class_name": "OrgDO", "name": "ORG" },
      { "class_name": "ProjectDO", "name": "PROJECT" },
      { "class_name": "GlobalDO", "name": "GLOBAL" },
      { "class_name": "ChannelDO", "name": "CHANNEL" },
      { "class_name": "SessionDO", "name": "SESSION" },
      { "class_name": "DecisionDO", "name": "DECISION" },
      { "class_name": "UserDO", "name": "USER" },
      { "class_name": "GraphDO", "name": "GRAPH" }
    ]
  },
  // Cloudflare's own record of which classes exist (not our SQLite migrations, which are in src/migrations.ts).
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["OrgDO"] },
    { "tag": "v2", "new_sqlite_classes": ["ProjectDO"] },
    { "tag": "v3", "new_sqlite_classes": ["GlobalDO"] },
    { "tag": "v4", "new_sqlite_classes": ["ChannelDO"] },
    { "tag": "v5", "new_sqlite_classes": ["SessionDO", "UserDO"] },
    { "tag": "v6", "new_sqlite_classes": ["GraphDO"] },
    { "tag": "v7", "new_sqlite_classes": ["DecisionDO"] }
  ],

  "vars": {
    // Secrets (JWT_SECRET, CLERK_SECRET_KEY, FLY_API_TOKEN, REPORTING_TOKEN, OPENROUTER_API_KEY) are NOT here — they
    // live in .dev.vars (local dev, gitignored) and `wrangler secret` (deployed). Only non-secret config below.
    "VM_URL": "http://localhost:5050",
    "FLY_ORG_SLUG": "superatom",
    // Clerk publishable key — used by GET /mobile/auth to render the sign-in page (same key as user-ui/main.tsx).
    // Public by design (the frontend API host is encoded in it); NOT a secret.
    "CLERK_PUBLISHABLE_KEY": "pk_test_YXB0LWFsaWVuLTIxLmNsZXJrLmFjY291bnRzLmRldiQ",
    // The reporting service — the ChannelDO POSTs answers to <REPORTING_URL>/render (Bearer REPORTING_TOKEN) to get a
    // rendered card image + full-report URL for chat channels. Presence of this var ENABLES that path; unset ⇒ the
    // ChannelDO falls back to the plain Adaptive Card. Public URL (the returned png/html are public too).
    "REPORTING_URL": "https://reports.superatom.site",
    // The platform's own domain: a connector may never be pointed at it (connectors/src/gateway.ts).
    "PLATFORM_DOMAIN": "superatom.site",
    // The organisations' warehouse (src/warehouse): the account and bucket its Basin Catalog lives in; the token is the
    // secret WAREHOUSE_CATALOG_TOKEN; data files are written through the WAREHOUSE binding below.
    "WAREHOUSE_ACCOUNT_ID": "91e1058d99235b9c34602fb0c28916d3",
    "WAREHOUSE_BUCKET": "sa-iceberg-warehouse",
    // Speech-to-text model for POST /api/transcribe (module: src/transcription/). Any audio-capable OpenRouter model;
    // changing it needs no code edit or redeploy of the module.
    "TRANSCRIBE_MODEL": "google/gemini-2.5-flash-lite"
  },

  "kv_namespaces": [
    // Hot-read cache for *.superatom.site subdomain → projectId resolution. Edge-cached + globally distributed, so the
    // GlobalDO registry stays off the hot path.
    { "binding": "DOMAINS", "id": "2f6f21f80d0a4526a9b1b4826c7a9614" },
    // CREDENTIALS — everything about WHICH credential is used and WHO may use it: provider key pools, the group a
    // project belongs to, which keys are currently exhausted. Named for the subject, not for the proxy, because the
    // proxy is only its first consumer. It never holds a secret VALUE: values live in Worker secrets and are resolved
    // by name at the moment of use.
    { "binding": "CREDENTIALS", "id": "c574f1b1a8494d64b143535f08163239" }
  ],

  "assets": {
    "directory": "./dist/client",
    // expose env.ASSETS so the worker can serve SPA index fallbacks
    "binding": "ASSETS",
    // The worker handles SPA fallback per prefix (/admin → admin index, /u → user index), so the asset layer does not
    // auto-serve a single root index.
    "not_found_handling": "none"
  },

  // Everything runs on superatom.site. *.superatom.site → this same worker (admin + per-subdomain user apps). The
  // wildcard needs a zone route (custom_domain doesn't support wildcards).
  "routes": [
    { "pattern": "*.superatom.site/*", "zone_name": "superatom.site" },
    { "pattern": "superatom.site/*", "zone_name": "superatom.site" }
  ],

  // Built dashboards and program bundles: the bucket is shared; the prefix keeps projects apart, and a build id in the
  // path makes rollback a metadata change rather than a re-upload.
  // The audit history, to the platform's own Basin: the audit_events stream (schema-checked) → the "audit" pipeline →
  // Parquet in R2 (superatom-platform/audit/events/year=/month=/day=). Each project's DO also keeps every event itself.
  "pipelines": [
    { "binding": "AUDIT", "stream": "deffa5578eda490d973c001bbd381baa" }
  ],

  "r2_buckets": [
    { "binding": "WAREHOUSE", "bucket_name": "sa-iceberg-warehouse" },
    { "binding": "PACKAGES", "bucket_name": "frontend-packages" }
  ]
}
